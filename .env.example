# Copie para .env.local e preencha. Nunca commite valores reais.
# Em produção, estas variáveis ficam no cofre da Vercel.

# Supabase (projeto task-chat)
NEXT_PUBLIC_SUPABASE_URL=https://lbqmanwfgnhugjefluzy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (cliente criado no Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave de 32 bytes em base64 para criptografar o refresh token (AES-256-GCM).
# Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Segredo do cron diário de sync
CRON_SECRET=
